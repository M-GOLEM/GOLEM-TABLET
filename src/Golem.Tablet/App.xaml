<Application x:Class="Golem.Tablet.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Golem.Tablet.Converters"
             xmlns:vm="clr-namespace:Golem.Tablet.ViewModels"
             xmlns:views="clr-namespace:Golem.Tablet.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:MaxValueConverter x:Key="MaxValue" />
            <conv:DeviceFamilyToBrushConverter x:Key="FamilyBrush" />
            <conv:LogLevelToBrushConverter x:Key="LogLevelBrush" />
            <conv:FirmwareSeverityToBrushConverter x:Key="FirmwareSeverityBrush" />
            <conv:DriverSeverityToBrushConverter x:Key="DriverSeverityBrush" />

            <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
                <views:DevicesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdbViewModel}">
                <views:AdbView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FastbootViewModel}">
                <views:FastbootView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SamsungViewModel}">
                <views:SamsungView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QualcommViewModel}">
                <views:QualcommView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MediaTekViewModel}">
                <views:MediaTekView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SpreadtrumViewModel}">
                <views:SpreadtrumView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DriversViewModel}">
                <views:DriversView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogsViewModel}">
                <views:LogsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
