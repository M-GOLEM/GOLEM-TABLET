<Window x:Class="Golem.Tablet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOLEM TABLET"
        Icon="Assets/app.ico"
        Height="880" Width="1360"
        MinHeight="720" MinWidth="1120"
        Background="{StaticResource BgBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        StateChanged="OnWindowStateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" BorderBrush="#2A3341" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ======================= Title bar ======================= -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderGradient}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="False">
                        <Border Width="38" Height="38" CornerRadius="11"
                                Background="{StaticResource AccentGradient}"
                                Effect="{StaticResource AccentGlow}">
                            <Border BorderBrush="#59FFFFFF" BorderThickness="1" CornerRadius="10">
                                <TextBlock Text="G" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource OnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="GOLEM TABLET" FontSize="15.5" FontWeight="SemiBold" />
                            <TextBlock Text="Device management &amp; diagnostics" FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Style="{StaticResource Chip}" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource FaintBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDevices}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding HeaderStatus}" FontSize="11.5"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Button Content="Refresh" Command="{Binding RefreshDevicesCommand}"
                                Style="{StaticResource AccentButton}" Margin="0,0,8,0" />

                        <Button Content="Activity log" Command="{Binding ToggleLogCommand}" Margin="0,0,10,0" />

                        <Border Width="1" Height="26" Background="{StaticResource BorderBrush}"
                                Margin="0,0,10,0" />

                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                                Click="OnMinimizeClick" ToolTip="Minimize" Margin="0,0,2,0">
                            <Path Data="M 0,5.5 L 11,5.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                                Click="OnMaximizeClick" ToolTip="Maximize" Margin="0,0,2,0">
                            <Path x:Name="MaximizeIcon"
                                  Data="M 0.5,0.5 L 10.5,0.5 L 10.5,10.5 L 0.5,10.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.1" StrokeLineJoin="Round" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}"
                                Click="OnCloseClick" ToolTip="Close">
                            <Path Data="M 0,0 L 11,11 M 11,0 L 0,11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================= Body ======================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SidebarGradient}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="14,20,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="WORKSPACE" Style="{StaticResource Eyebrow}"
                                   Foreground="{StaticResource FaintBrush}"
                                   Margin="12,0,0,10" />

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Navigation}"
                                 SelectedItem="{Binding SelectedNavigation}"
                                 Style="{StaticResource NavList}"
                                 ItemContainerStyle="{StaticResource NavItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Description}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="NavIndex" Text="{Binding Number}"
                                                   Style="{StaticResource NavNumber}"
                                                   VerticalAlignment="Center" Margin="2,0,0,0" />
                                        <TextBlock x:Name="NavTitle" Grid.Column="1" Text="{Binding Title}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Value="True"
                                                     Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                            <Setter TargetName="NavIndex" Property="Foreground"
                                                    Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="NavTitle" Property="Foreground"
                                                    Value="{StaticResource AccentBrightBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Style="{StaticResource Inset}" Padding="12,10" Margin="0,10,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}"
                                             VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="Local-only build" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="No update service, telemetry or network access."
                                           Foreground="{StaticResource FaintBrush}" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Page -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="28,22,28,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedNavigation.Title}"
                                           Style="{StaticResource PageTitle}" />
                                <TextBlock Text="{Binding SelectedNavigation.Description}"
                                           Style="{StaticResource PageSubtitle}" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource Chip}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="MODULE" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{StaticResource FaintBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedNavigation.Number}" FontSize="10.5"
                                               FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"
                                               Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"
                                    Margin="28,18,28,12" />
                </Grid>
            </Grid>

            <!-- ======================= Activity dock ======================= -->
            <Border Grid.Row="2" Height="222"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="20,10,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="ACTIVITY" Style="{StaticResource SectionHeader}"
                                       Margin="0" VerticalAlignment="Center" />
                            <TextBlock Text="live session log" Style="{StaticResource MutedText}"
                                       FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox Content="Follow" IsChecked="{Binding IsLogPinned}" Margin="0,0,14,0" />
                            <Button Content="Clear" Command="{Binding ClearLogCommand}"
                                    Style="{StaticResource GhostButton}" Margin="0,0,2,0" />
                            <Button Content="Export" Command="{Binding ExportLogCommand}"
                                    Style="{StaticResource GhostButton}" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="LogList" Grid.Row="1" Margin="0,6,0,0"
                             ItemsSource="{Binding Log.Entries}"
                             Style="{StaticResource LogList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimestampText}" Style="{StaticResource MonoText}"
                                               Foreground="{StaticResource FaintBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LevelText}"
                                               Style="{StaticResource MonoText}"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Category}"
                                               Style="{StaticResource MonoText}"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding Message}"
                                               Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ======================= Status bar ======================= -->
            <Border Grid.Row="3" Background="{StaticResource StatusBarBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="20,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource SuccessBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Offline by design" FontSize="10.5"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="·" FontSize="10.5" Foreground="{StaticResource FaintBrush}"
                                   Margin="8,0" VerticalAlignment="Center" />
                        <TextBlock Text="no update service · no telemetry" FontSize="10.5"
                                   Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="GOLEM TABLET 1.0.0 · M-GOLEM"
                               FontSize="10.5" Foreground="{StaticResource FaintBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
