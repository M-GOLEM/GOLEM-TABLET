<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>GolemTablet</AssemblyName>
    <RootNamespace>Golem.Tablet</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Company>M-GOLEM</Company>
    <Product>GOLEM TABLET</Product>
    <AssemblyTitle>GOLEM TABLET</AssemblyTitle>
    <Description>GOLEM TABLET - tablet device management and diagnostics for Windows.</Description>
    <Copyright>Copyright (c) 2026 M-GOLEM</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Golem.Tablet.Core\Golem.Tablet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
