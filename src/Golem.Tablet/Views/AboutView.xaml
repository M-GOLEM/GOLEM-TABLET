<UserControl x:Class="Golem.Tablet.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" MaxWidth="760" HorizontalAlignment="Left" Padding="30">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="64" Height="64" CornerRadius="16"
                            Background="{StaticResource AccentGradient}"
                            Effect="{StaticResource AccentGlow}">
                        <Border BorderBrush="#59FFFFFF" BorderThickness="1" CornerRadius="15">
                            <TextBlock Text="G" FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource OnAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppName}" FontSize="24" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Border Style="{StaticResource ChipAccent}" Padding="9,2">
                                <TextBlock FontSize="10.5" Foreground="{StaticResource AccentBrush}">
                                    <Run Text="v" /><Run Text="{Binding Version, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Developed by" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="12,0,4,0" />
                            <TextBlock Text="{Binding Developer}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,20,0,0"
                           FontSize="13" Foreground="{StaticResource MutedBrush}" LineHeight="20" />

                <Border Style="{StaticResource Divider}" Margin="0,22,0,20" />

                <TextBlock Text="PRIVACY" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{Binding PrivacyStatement}" TextWrapping="Wrap"
                           Style="{StaticResource MutedText}" LineHeight="18" />

                <TextBlock Text="THIRD-PARTY COMPONENTS" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
                <TextBlock Text="{Binding ThirdPartyNote}" TextWrapping="Wrap"
                           Style="{StaticResource MutedText}" LineHeight="18" />

                <TextBlock Text="SOURCE" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
                <Border Style="{StaticResource Inset}" Padding="14,10">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="GitHub profile" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding ProfileUrl}" TextWrapping="Wrap"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                        <Button Content="Open profile" Command="{Binding OpenProfileCommand}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource AccentButton}" Padding="14,6" Margin="14,0,0,0" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
