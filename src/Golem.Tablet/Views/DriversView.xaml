<UserControl x:Class="Golem.Tablet.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Inspect drivers" Command="{Binding InspectCommand}"
                            Style="{StaticResource AccentButton}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="420" />
                </StackPanel>
                <TextBlock Text="{Binding ElevationText}" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="360"
                           ToolTip="{Binding ElevationText}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="8,4,8,10">
                        <TextBlock Text="DRIVER PROBLEMS" Style="{StaticResource SectionHeader}"
                                   Margin="0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Padding="9,2">
                            <TextBlock FontSize="10.5" Foreground="{StaticResource MutedBrush}">
                                <Run Text="{Binding Issues.Count, Mode=OneWay}" />
                                <Run Text="reported" />
                            </TextBlock>
                        </Border>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding Error}"
                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                               Margin="8,0,8,10"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                    <Grid>
                        <ListBox ItemsSource="{Binding Issues}" Style="{StaticResource PlainList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Style="{StaticResource Chip}" Padding="8,1">
                                                <TextBlock Text="{Binding CodeText}" FontSize="10.5"
                                                           Foreground="{Binding Severity, Converter={StaticResource DriverSeverityBrush}}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding PnpDeviceId}" Style="{StaticResource MutedText}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Issues.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInspected}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="46" Height="46" CornerRadius="12"
                                        Background="{StaticResource PanelAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="?" FontSize="20" Foreground="{StaticResource FaintBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Not inspected yet" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                                <TextBlock Text="Run a driver inspection to check connected devices for problem codes."
                                           Style="{StaticResource MutedText}" TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center" Visibility="Collapsed">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInspected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="46" Height="46" CornerRadius="12"
                                        Background="{StaticResource PanelAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <Path Data="M 2,10 L 8,16 L 18,4" Stroke="{StaticResource SuccessBrush}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No driver problems reported" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                                <TextBlock Text="Every inspected USB device returned a healthy driver state."
                                           Style="{StaticResource MutedText}" TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Inset}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="SAFE BY DEFAULT" Style="{StaticResource SectionHeader}"
                                       Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="This page only reads device state. It never installs, updates, or replaces drivers."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="WHAT TO DO" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding Guidance}" TextWrapping="Wrap" LineHeight="20"
                                       Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
