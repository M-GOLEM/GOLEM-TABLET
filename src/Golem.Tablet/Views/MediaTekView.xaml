<UserControl x:Class="Golem.Tablet.Views.MediaTekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Refresh ports" Command="{Binding RefreshPortsCommand}"
                            Style="{StaticResource AccentButton}" />
                    <Button Content="Detect MediaTek devices" Command="{Binding DetectDevicesCommand}"
                            Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="520" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SERIAL PORTS"
                               Style="{StaticResource SectionHeader}" Margin="8,4,0,10" />
                    <ListBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"
                             Style="{StaticResource PlainList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource MonoText}"
                                           FontSize="12.5" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="COMMAND OUTPUT" Style="{StaticResource SectionHeader}"
                                   Margin="0" VerticalAlignment="Center" />
                        <TextBlock Text="Working…" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <Border Style="{StaticResource Inset}" Padding="12,10" Background="#080B0F">
                        <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="12"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" />
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="AT COMMAND" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" />
                    <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}"
                            Style="{StaticResource AccentButton}" Margin="8,0,0,0" />
                </Grid>
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Identity (ATI)" Command="{Binding AtiCommand}" Margin="0,0,8,8" />
                    <Button Content="Model" Command="{Binding ModelCommand}" Margin="0,0,8,8" />
                    <Button Content="Revision" Command="{Binding RevisionCommand}" Margin="0,0,8,8" />
                    <Button Content="Serial (IMEI)" Command="{Binding SerialNumberCommand}" Margin="0,0,8,8" />
                    <Button Content="Signal" Command="{Binding SignalCommand}" Margin="0,0,8,8" />
                    <Button Content="Registration" Command="{Binding RegistrationCommand}" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                           Text="Serial numbers and subscriber identifiers are redacted in the activity log." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
