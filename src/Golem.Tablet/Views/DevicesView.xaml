<UserControl x:Class="Golem.Tablet.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                            Style="{StaticResource AccentButton}" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" MaxWidth="520" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="8,4,8,10">
                        <TextBlock Text="USB DEVICES" Style="{StaticResource SectionHeader}"
                                   Margin="0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Padding="9,2">
                            <TextBlock FontSize="10.5" Foreground="{StaticResource MutedBrush}">
                                <Run Text="{Binding DeviceCount, Mode=OneWay}" />
                                <Run Text="connected" />
                            </TextBlock>
                        </Border>
                    </Grid>

                    <Grid>
                        <ListBox ItemsSource="{Binding Devices}"
                                 SelectedItem="{Binding SelectedDevice}"
                                 Style="{StaticResource PlainList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0">
                                                <Run Text="{Binding VidPid, Mode=OneWay}" />
                                                <Run Text="·" Foreground="{StaticResource FaintBrush}" />
                                                <Run Text="{Binding Service, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Margin="0,0,6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FamilyText}" Value="Unknown">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,7,0"
                                                             Fill="{Binding Family, Converter={StaticResource FamilyBrush}}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding FamilyText}" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ModeText}" Value="Unknown">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ModeText}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340"
                                   Visibility="{Binding EmptyMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="SELECTED DEVICE" Style="{StaticResource SectionHeader}"
                                           Margin="0" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Chip}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Padding="9,2">
                                    <TextBlock Text="{Binding SelectedDevice.Record.Status}" FontSize="10.5"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding SelectedDevice.Name}" FontSize="18" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding SelectedDevice.ModeText}" FontSize="11.5"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14" />

                            <Border Style="{StaticResource Divider}" Margin="0,0,0,14" />

                            <TextBlock Text="Family" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding SelectedDevice.FamilyText}" Style="{StaticResource ValueText}" />
                            <TextBlock Text="Connection mode" Style="{StaticResource LabelText}" Margin="0,12,0,3" />
                            <TextBlock Text="{Binding SelectedDevice.ModeText}" Style="{StaticResource ValueText}" />
                            <TextBlock Text="Hardware ID" Style="{StaticResource LabelText}" Margin="0,12,0,3" />
                            <TextBlock Text="{Binding SelectedDevice.VidPid}" Style="{StaticResource ValueText}"
                                       FontFamily="Consolas" />
                            <TextBlock Text="Serial" Style="{StaticResource LabelText}" Margin="0,12,0,3" />
                            <TextBlock Text="{Binding SelectedDevice.Serial}" Style="{StaticResource ValueText}"
                                       FontFamily="Consolas" />
                            <TextBlock Text="Driver service" Style="{StaticResource LabelText}" Margin="0,12,0,3" />
                            <TextBlock Text="{Binding SelectedDevice.Service}" Style="{StaticResource ValueText}" />
                            <TextBlock Text="PnP device ID" Style="{StaticResource LabelText}" Margin="0,12,0,3" />
                            <TextBlock Text="{Binding SelectedDevice.Record.PnpDeviceId}"
                                       Style="{StaticResource ValueText}" FontFamily="Consolas" FontSize="11" />
                            <Border Height="6" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="240"
                                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                        <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                HorizontalAlignment="Center">
                            <TextBlock Text="?" FontSize="20" Foreground="{StaticResource FaintBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Select a device to see its details."
                                   Style="{StaticResource MutedText}" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
