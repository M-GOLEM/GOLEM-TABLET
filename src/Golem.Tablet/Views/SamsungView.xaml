<UserControl x:Class="Golem.Tablet.Views.SamsungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="SAMSUNG FIRMWARE VALIDATION" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{Binding RequiredFiles}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding FirmwarePath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}"
                            Margin="8,0,0,0" />
                    <Button Grid.Column="2" Content="Inspect" Command="{Binding InspectCommand}"
                            Style="{StaticResource AccentButton}" Margin="8,0,0,0" />
                </Grid>

                <Grid Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="Verify embedded MD5 checksum" IsChecked="{Binding VerifyChecksum}" />
                        <Button Content="Detect Samsung devices" Command="{Binding DetectDevicesCommand}"
                                Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Working…" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="INSPECTION RESULT" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="Detected format:" />
                            <Run Text="{Binding FormatLabel, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="Components:" />
                            <Run Text="{Binding ComponentSummary, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>

                    <Grid Margin="0,10,0,0"
                          Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="ISSUES"
                                       Style="{StaticResource SectionHeader}" />
                            <TextBlock DockPanel.Dock="Top" Text="No issues reported."
                                       Style="{StaticResource MutedText}" Margin="0,0,0,4"
                                       Visibility="{Binding HasIssues, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ListBox ItemsSource="{Binding Issues}" Style="{StaticResource PlainList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SeverityText}" FontSize="11"
                                                       Foreground="{Binding Severity, Converter={StaticResource FirmwareSeverityBrush}}" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="PACKAGE ENTRIES"
                                       Style="{StaticResource SectionHeader}" />
                            <TextBlock DockPanel.Dock="Top" Text="No file entries found."
                                       Style="{StaticResource MutedText}" Margin="0,0,0,4"
                                       Visibility="{Binding HasEntries, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ListBox ItemsSource="{Binding Entries}" Style="{StaticResource PlainList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Kind}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       Style="{StaticResource MonoText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="DETECTED DEVICES"
                                   Style="{StaticResource SectionHeader}" />
                        <TextBlock DockPanel.Dock="Top" Text="No Samsung devices connected."
                                   Margin="2,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DetectedDevices.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox ItemsSource="{Binding DetectedDevices}" Style="{StaticResource PlainList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ModeText}" Style="{StaticResource MutedText}"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding VidPid}" Style="{StaticResource MutedText}"
                                                   FontFamily="Consolas" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="FLASHING NOTICE" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding FlashingNotice}" TextWrapping="Wrap"
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
