<UserControl x:Class="Golem.Tablet.Views.FastbootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Refresh devices" Command="{Binding RefreshDevicesCommand}"
                            Style="{StaticResource AccentButton}" />
                    <Button Content="Check version" Command="{Binding VersionCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="560" />
            </Grid>
        </Border>

        <ScrollViewer x:Name="PageScroll" Grid.Row="1" Margin="0,14,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=PageScroll,
                                 Converter={StaticResource MaxValue}, ConverterParameter=350}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="110" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="FASTBOOT DEVICES"
                                   Style="{StaticResource SectionHeader}" Margin="8,4,0,10" />
                        <TextBlock DockPanel.Dock="Top" Text="No fastboot devices. Reboot the tablet into bootloader mode and reconnect."
                                   TextWrapping="Wrap" Margin="8,0,8,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                 Style="{StaticResource PlainList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Serial}" FontFamily="Consolas"
                                                   FontWeight="SemiBold" FontSize="12.5" />
                                        <TextBlock Text="{Binding State}" Style="{StaticResource MutedText}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="BOOTLOADER ACTIONS" Style="{StaticResource SectionHeader}" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Reboot system" Command="{Binding RebootSystemCommand}" Margin="0,0,8,6" />
                            <Button Content="Reboot bootloader" Command="{Binding RebootBootloaderCommand}" Margin="0,0,8,6" />
                            <Button Content="Reboot recovery" Command="{Binding RebootRecoveryCommand}" Margin="0,0,8,6" />
                            <Button Content="Reboot fastbootd" Command="{Binding RebootFastbootdCommand}" Margin="0,0,8,6" />
                            <Button Content="Continue boot" Command="{Binding ContinueCommand}" Margin="0,0,8,6" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="Reboot and continue actions ask for confirmation when it is enabled in Settings." />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="110" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="16">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="BOOTLOADER VARIABLES" Style="{StaticResource SectionHeader}"
                                       Margin="0" VerticalAlignment="Center" />
                            <Button Content="Read variables" Command="{Binding ReadVariablesCommand}"
                                    HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="No variables read. Select Read variables to query getvar all."
                                   TextWrapping="Wrap" Margin="2,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Variables.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox ItemsSource="{Binding Variables}" Style="{StaticResource PlainList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource MonoText}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                   Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="LAST OUTPUT" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Inset}" Padding="12,10" Background="#080B0F">
                            <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     FontFamily="Consolas" FontSize="12" MinHeight="64" MaxHeight="120"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     Background="Transparent" BorderThickness="0" Padding="0" />
                        </Border>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Read-only by design: this build does not unlock bootloaders or flash partitions." />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
